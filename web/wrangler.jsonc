{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "auctionhub",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/a/*", "/robots.txt", "/sitemap.xml"]
  },
  // Every 2 days: ping Supabase so the free project never pauses for inactivity.
  // Keepalive every 2 days; storage orphan sweep nightly (needs SUPABASE_SERVICE_ROLE_KEY secret).
  "triggers": { "crons": ["0 6 */2 * *", "30 3 * * *"] },
  "observability": { "enabled": true },
  // Public values only (the publishable/anon key already ships in the frontend bundle).
  // Never put the service_role key here; use `wrangler secret put` instead.
  "vars": {
    "SUPABASE_URL": "https://yuqccqmzxmpxfedmkgwp.supabase.co",
    "SUPABASE_ANON_KEY": "sb_publishable_Ak3U7v5jtZgzGk_y5fQE6g_ZslpA64f"
  }
}
