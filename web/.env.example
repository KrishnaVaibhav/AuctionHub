# Copy to .env.local for local dev. Values from `npx supabase status` (local)
# or Supabase Dashboard > Project Settings > API (cloud).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-local-anon-or-publishable-key
# Optional: error monitoring (Sentry project DSN). Leave empty to disable.
VITE_SENTRY_DSN=

# Local-only test accounts used for manual testing against `npx supabase start`
# (local email confirmation is off, so sign up via /login with these):
#   host:   host@test.localhost   / LocalTest#2026
#   bidder: bidder@test.localhost / LocalTest#2026
